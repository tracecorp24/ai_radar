# General Settings
PROJECT_NAME="Vendor-Independent AI Product"
ENVIRONMENT=development
LOG_LEVEL=INFO

# API & Security
SECRET_KEY=change-this-super-secret-key-in-production-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Settings (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_db

# Frontend Integration
FRONTEND_URL=http://localhost:3000

# External AI Provider Keys (Vendor-Independent LLM Adapter)
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
